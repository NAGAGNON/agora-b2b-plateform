# ---------------------------------------------------------------------------
# LinkProB2B — variables d'environnement
# Copier en .env.local (développement) ou les saisir dans Vercel (production).
# Aucune de ces clés n'est envoyée au navigateur.
# ---------------------------------------------------------------------------

# URL publique du site (liens dans les e-mails, sitemap, canonical)
SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). En local : `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role / sb_secret_…) — SERVEUR UNIQUEMENT, ne jamais l'exposer
SUPABASE_SECRET_KEY=

# Secret partagé pour les tâches planifiées (/api/cron/*), ex. : openssl rand -hex 32
CRON_SECRET=

# Sel pour pseudonymiser les IP dans la limitation de débit, ex. : openssl rand -hex 32
RATE_LIMIT_SALT=

# E-mail transactionnel (facultatif). Sans clé, les e-mails sont mis en file
# mais marqués « SKIPPED » (aucun envoi réel).
RESEND_API_KEY=
EMAIL_FROM="LinkProB2B <notifications@votre-domaine.fr>"
