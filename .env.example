# ---------------------------------------------------------------------------
# LinkProB2B — variables d'environnement
# Copier en .env.local (développement) ou les saisir dans Vercel.
# Seules l'URL Supabase et la clé publique (anon / publishable) sont envoyées
# au navigateur, pour le temps réel ; elles sont conçues pour être publiques
# (accès contrôlé par la sécurité au niveau des lignes, RLS).
# ---------------------------------------------------------------------------

# Environnement : development | staging | production
#  - staging    : prévisualisation, données de démonstration autorisées,
#                 activation immédiate des comptes si aucun fournisseur e-mail
#  - production : données réelles uniquement, confirmation d'e-mail obligatoire
# Sur Vercel, déduit automatiquement de VERCEL_ENV si absent.
APP_ENV=development

# URL publique du site (liens dans les e-mails, sitemap, canonical).
# Sur Vercel, déduite automatiquement si absente.
SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). En local : `npx supabase status`.
# L'intégration Vercel ↔ Supabase fournit aussi NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY, reconnues automatiquement.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role / sb_secret_…) — SERVEUR UNIQUEMENT, ne jamais l'exposer
SUPABASE_SECRET_KEY=

# Connexion PostgreSQL directe (port 5432, sans pooler) utilisée UNIQUEMENT au
# déploiement pour appliquer les migrations (scripts/migrate.mjs).
# Fournie par l'intégration Vercel ↔ Supabase sous le nom POSTGRES_URL_NON_POOLING.
# DATABASE_URL=

# Adresse e-mail du premier super-administrateur : promu automatiquement à sa
# première connexion, tant qu'aucun super-administrateur n'existe.
INITIAL_ADMIN_EMAIL=

# Secret partagé pour les tâches planifiées (/api/cron/*), ex. : openssl rand -hex 32
# (Vercel l'envoie automatiquement à la tâche planifiée.)
CRON_SECRET=

# Sel pour pseudonymiser les IP dans la limitation de débit (facultatif :
# dérivé de la clé secrète s'il est absent), ex. : openssl rand -hex 32
RATE_LIMIT_SALT=

# E-mail transactionnel via Resend (https://resend.com) : confirmation
# d'inscription, réinitialisation du mot de passe, notifications, alertes.
# Sans clé : e-mails journalisés mais non envoyés (« SKIPPED »).
# Envoi des e-mails par le serveur SMTP de la messagerie du domaine (aucun coût par e-mail).
# Prioritaire sur Resend. Identifiants côté serveur uniquement (jamais exposés au navigateur).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true       # TLS direct (port 465)
# SMTP_HELO_NAME=        # nom annoncé en EHLO (facultatif)
# Ancien fournisseur (API), utilisé seulement si le SMTP n'est pas configuré :
RESEND_API_KEY=

# Paiement Stripe (Tableau de bord Stripe, en mode TEST : « Developers → API keys » et « Products »).
# Côté serveur uniquement : aucune de ces valeurs n'est envoyée au navigateur.
# sk_test_… (mode test). Une clé sk_live_… est refusée sans STRIPE_ALLOW_LIVE=1
STRIPE_SECRET_KEY=
# pk_test_… (facultative : le paiement se fait sur la page hébergée Stripe Checkout)
STRIPE_PUBLISHABLE_KEY=
# whsec_… (Developers → Webhooks → endpoint https://<domaine>/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# price_… prix mensuel récurrent de « LinkProB2B Pro » (29 € HT)
STRIPE_PRO_PRICE_ID=
# price_… prix mensuel récurrent de « LinkProB2B Business » (59 € HT)
STRIPE_BUSINESS_PRICE_ID=
# txr_… facultatif : taux de TVA 20 % « exclusive » ajouté au prix HT
STRIPE_TAX_RATE_ID=
# STRIPE_ALLOW_LIVE=1         # à n'ajouter qu'au passage en production (paiements réels)

# Analyses de marché rédigées par IA (Administration → Articles). Sans clé : fonction inactive.
ANTHROPIC_API_KEY=
# Rapport complet de la journée envoyé chaque soir (une ou plusieurs adresses séparées par des virgules ;
# à défaut : les super-administrateurs)
DAILY_REPORT_EMAIL=
# Google Search Console : code de vérification (balise « google-site-verification », sans guillemets)
GOOGLE_SITE_VERIFICATION=
# IndexNow : clé facultative (sinon dérivée de CRON_SECRET), publiée sur /indexnow.txt
INDEXNOW_KEY=
EMAIL_FROM="LinkProB2B <notifications@votre-domaine.fr>"

# --- LinkProB2B Outreach (prospection) — voir docs/OUTREACH.md
# Interrupteur d'urgence : « false » coupe tout envoi réel de prospection (actif par défaut)
OUTREACH_SEND_ENABLED=
# Expéditeur (facultatif) : par défaut la même adresse que les e-mails d'inscription
OUTREACH_EMAIL_FROM=
# Secret des liens personnalisés (facultatif : dérivé de SUPABASE_SECRET_KEY sinon)
OUTREACH_TOKEN_SECRET=
# Recherche des adresses e-mail génériques (au moins une clé) — voir docs/OUTREACH.md
BRAVE_SEARCH_API_KEY=
DROPCONTACT_API_KEY=
