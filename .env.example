# ---------------------------------------------------------------------------
# LinkProB2B — variables d'environnement
# Copier en .env.local (développement) ou les saisir dans Vercel.
# Seules l'URL Supabase et la clé publique (anon / publishable) sont envoyées
# au navigateur, pour le temps réel ; elles sont conçues pour être publiques
# (accès contrôlé par la sécurité au niveau des lignes, RLS).
# ---------------------------------------------------------------------------

# Environnement : development | staging | production
#  - staging    : prévisualisation, données de démonstration autorisées,
#                 activation immédiate des comptes si aucun fournisseur e-mail
#  - production : données réelles uniquement, confirmation d'e-mail obligatoire
# Sur Vercel, déduit automatiquement de VERCEL_ENV si absent.
APP_ENV=development

# URL publique du site (liens dans les e-mails, sitemap, canonical).
# Sur Vercel, déduite automatiquement si absente.
SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). En local : `npx supabase status`.
# L'intégration Vercel ↔ Supabase fournit aussi NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY, reconnues automatiquement.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role / sb_secret_…) — SERVEUR UNIQUEMENT, ne jamais l'exposer
SUPABASE_SECRET_KEY=

# Connexion PostgreSQL directe (port 5432, sans pooler) utilisée UNIQUEMENT au
# déploiement pour appliquer les migrations (scripts/migrate.mjs).
# Fournie par l'intégration Vercel ↔ Supabase sous le nom POSTGRES_URL_NON_POOLING.
# DATABASE_URL=

# Adresse e-mail du premier super-administrateur : promu automatiquement à sa
# première connexion, tant qu'aucun super-administrateur n'existe.
INITIAL_ADMIN_EMAIL=

# Secret partagé pour les tâches planifiées (/api/cron/*), ex. : openssl rand -hex 32
# (Vercel l'envoie automatiquement à la tâche planifiée.)
CRON_SECRET=

# Sel pour pseudonymiser les IP dans la limitation de débit (facultatif :
# dérivé de la clé secrète s'il est absent), ex. : openssl rand -hex 32
RATE_LIMIT_SALT=

# E-mail transactionnel via Resend (https://resend.com) : confirmation
# d'inscription, réinitialisation du mot de passe, notifications, alertes.
# Sans clé : e-mails journalisés mais non envoyés (« SKIPPED »).
RESEND_API_KEY=
EMAIL_FROM="LinkProB2B <notifications@votre-domaine.fr>"
