# Copiez ce fichier en .env puis renseignez les valeurs. Ne le commitez jamais.
POSTGRES_PASSWORD=changez-moi
# Mot de passe de connexion à l'application (propriétaire unique)
ADMIN_PASSWORD=changez-moi-aussi
# Chaîne aléatoire longue (chiffrement des clés API + signature des sessions) : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Nom de domaine pointant vers le VPS (HTTPS automatique) ; localhost pour un essai local
DOMAIN=localhost
# Mettre false si vous accédez en http (essai local sans HTTPS)
COOKIE_SECURE=true
TIMEZONE=Europe/Paris
# Facultatif : la clé Claude peut aussi être saisie dans l'application (Paramètres → Clés API, stockée chiffrée)
ANTHROPIC_API_KEY=
# Facultatif : e-mails de notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BACKUP_RETENTION_DAYS=14
